#!/usr/bin/env bash
# Buddy launcher script
# Launches or switches to the Buddy session in Rex

set -euo pipefail

BUDDY_DIR="$HOME/.buddy"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
BUDDY_CTL="$REPO_DIR/skills/buddy/scripts/buddy-ctl"

# Resolve buddy-ctl CLI executable
BUDDY_CTL_CMD=""
if command -v buddy-ctl >/dev/null 2>&1; then
    BUDDY_CTL_CMD="buddy-ctl"
elif [ -x "$BUDDY_CTL" ]; then
    BUDDY_CTL_CMD="$BUDDY_CTL"
fi

print_help() {
    cat <<'EOF'
Usage: buddy [options] [agent] [-- <agent-args...>]

Launch or switch to the Buddy orchestrator session in Rex.

Options:
  -a, --agent <agent>   Agent to launch in the orchestrator session
  -h, --help            Show this help message and exit

Positional Agent:
  agy, pi, opencode, claude, codex, cursor, gemini

Agent Resolution:
  1. CLI argument (--agent, -a, or positional)
  2. BUDDY_AGENT environment variable
  3. config.orchestrator_agent (in ~/.buddy/config.json)
  4. config.default_agent
  5. Default fallback: agy

Passthrough:
  Use '--' to pass flags and options directly to the underlying agent.
  Everything after '--' is forwarded untouched.

Examples:
  buddy                     Launch or attach using default agent
  buddy opencode            Launch with opencode agent
  buddy -a pi               Launch with pi agent
  buddy -- --model pro      Pass '--model pro' directly to the agent

Controller Commands:
  Run 'buddy-ctl --help' for task dispatch, status, and project management.
EOF
}

# Parse agent selection and arguments
# Supported syntax:
#   buddy pi / buddy opencode / buddy agy
#   buddy --agent <agent> / buddy --agent=<agent>
#   buddy -a <agent> / buddy -a=<agent>
#   BUDDY_AGENT env var
#   Extra arguments forwarded to the resolved agent
CHOSEN_AGENT=""
EXTRA_ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            print_help
            exit 0
            ;;
        --agent)
            if [ $# -lt 2 ]; then
                echo "Error: --agent requires an agent name" >&2
                exit 1
            fi
            CHOSEN_AGENT="$2"
            shift 2
            ;;
        --agent=*)
            CHOSEN_AGENT="${1#*=}"
            shift
            ;;
        -a)
            if [ $# -lt 2 ]; then
                echo "Error: -a requires an agent name" >&2
                exit 1
            fi
            CHOSEN_AGENT="$2"
            shift 2
            ;;
        -a=*)
            CHOSEN_AGENT="${1#*=}"
            shift
            ;;
        agy|pi|opencode|claude|codex|cursor|gemini)
            if [ -z "$CHOSEN_AGENT" ]; then
                CHOSEN_AGENT="$1"
            else
                EXTRA_ARGS+=("$1")
            fi
            shift
            ;;
        --)
            shift
            while [ $# -gt 0 ]; do
                EXTRA_ARGS+=("$1")
                shift
            done
            break
            ;;
        -*)
            echo "Error: unknown option '$1'" >&2
            echo "Hint: Use 'buddy -- <args>' to pass options through to the agent." >&2
            echo >&2
            print_help >&2
            exit 2
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

# Ensure ~/.buddy exists
if [ -n "$BUDDY_CTL_CMD" ]; then
    "$BUDDY_CTL_CMD" init >/dev/null 2>&1 || true
fi

# Environment variable fallback if not specified on CLI
if [ -z "$CHOSEN_AGENT" ] && [ -n "${BUDDY_AGENT:-}" ]; then
    CHOSEN_AGENT="$BUDDY_AGENT"
fi

# Resolve orchestrator agent name:
# Precedence: CLI argument (--agent/-a/positional) -> BUDDY_AGENT env -> orchestrator_agent config -> default_agent config -> "agy"
RESOLVED_AGENT="$CHOSEN_AGENT"
if [ -z "$RESOLVED_AGENT" ]; then
    ORCH_AGENT=""
    if [ -n "$BUDDY_CTL_CMD" ]; then
        CFG_OUT="$("$BUDDY_CTL_CMD" config get orchestrator_agent 2>/dev/null || true)"
        if command -v jq >/dev/null 2>&1; then
            ORCH_AGENT="$(echo "$CFG_OUT" | jq -r '.value // empty' 2>/dev/null || true)"
        else
            ORCH_AGENT="$(echo "$CFG_OUT" | grep -o '"value": *"[^"]*"' | head -n 1 | cut -d'"' -f4 || true)"
        fi
        if [ "$ORCH_AGENT" = "null" ] || [ -z "$ORCH_AGENT" ]; then
            CFG_OUT="$("$BUDDY_CTL_CMD" config get default_agent 2>/dev/null || true)"
            if command -v jq >/dev/null 2>&1; then
                ORCH_AGENT="$(echo "$CFG_OUT" | jq -r '.value // empty' 2>/dev/null || true)"
            else
                ORCH_AGENT="$(echo "$CFG_OUT" | grep -o '"value": *"[^"]*"' | head -n 1 | cut -d'"' -f4 || true)"
            fi
        fi
    fi
    if [ "$ORCH_AGENT" = "null" ] || [ -z "$ORCH_AGENT" ]; then
        ORCH_AGENT="agy"
    fi
    RESOLVED_AGENT="$ORCH_AGENT"
fi

# Resolve command array from config.agents.<name>.command
RESOLVED_CMD=()
if [ -n "$BUDDY_CTL_CMD" ]; then
    CMD_JSON="$("$BUDDY_CTL_CMD" config get "agents.$RESOLVED_AGENT.command" 2>/dev/null || true)"
    if [ -n "$CMD_JSON" ]; then
        while IFS= read -r -d '' item; do
            [ -n "$item" ] && RESOLVED_CMD+=("$item")
        done < <(python3 -c "
import json, sys
try:
    data = json.loads(sys.argv[1])
    val = data.get('value')
    if isinstance(val, list):
        for part in val:
            sys.stdout.write(str(part) + '\0')
    elif isinstance(val, str) and val.strip() and val.strip().lower() != 'null':
        sys.stdout.write(val.strip() + '\0')
except Exception:
    pass
" "$CMD_JSON" 2>/dev/null || true)
    fi
fi

if [ ${#RESOLVED_CMD[@]} -eq 0 ]; then
    echo "Warning: Agent '$RESOLVED_AGENT' not found in config.agents. Falling back to bare executable '$RESOLVED_AGENT'." >&2
    RESOLVED_CMD=("$RESOLVED_AGENT")
fi

# Find Rex binary
REX_BIN="$(command -v rex 2>/dev/null || echo "/Users/sunday/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex")"

# If running inside Rex in the Buddy session, start the agent
CURRENT_SESS="${REX_SESSION:-}"
if [ -n "$CURRENT_SESS" ]; then
    SESS_LABEL="$("$REX_BIN" session inspect "$CURRENT_SESS" --json 2>/dev/null | jq -r '.label // empty' || true)"
    if [ "$SESS_LABEL" = "Buddy" ]; then
        cd "$BUDDY_DIR"
        if [ ${#EXTRA_ARGS[@]} -gt 0 ]; then
            exec "${RESOLVED_CMD[@]}" "${EXTRA_ARGS[@]}"
        else
            exec "${RESOLVED_CMD[@]}"
        fi
    fi
fi

# Check if a session named Buddy already exists in Rex
SESSIONS_JSON="$("$REX_BIN" ls --json 2>/dev/null || echo '{"sessions":[]}')"
BUDDY_SESS_ID="$(echo "$SESSIONS_JSON" | jq -r '.sessions[] | select(.label == "Buddy") | .session_id' | head -n 1)"

# Find connected Rex app client (GUI)
CLIENTS_JSON="$("$REX_BIN" client ls --json 2>/dev/null || echo '{"clients":[]}')"
APP_CLIENT_ID="$(echo "$CLIENTS_JSON" | jq -r '.clients[] | select(.info.kind == "app") | .client_id' | head -n 1)"

if [ -n "$BUDDY_SESS_ID" ]; then
    echo "Buddy session active in Rex ($BUDDY_SESS_ID)."
    if [ -n "$APP_CLIENT_ID" ]; then
        "$REX_BIN" -C "$APP_CLIENT_ID" do session.select "session_id=$BUDDY_SESS_ID" >/dev/null 2>&1 || true
        echo "Switched Rex to Buddy session."
    fi
else
    echo "Creating Buddy session in Rex..."
    if [ ${#EXTRA_ARGS[@]} -gt 0 ]; then
        NEW_SESS="$("$REX_BIN" new Buddy -c "$BUDDY_DIR" --window Buddy --json -- "${RESOLVED_CMD[@]}" "${EXTRA_ARGS[@]}")"
    else
        NEW_SESS="$("$REX_BIN" new Buddy -c "$BUDDY_DIR" --window Buddy --json -- "${RESOLVED_CMD[@]}")"
    fi
    BUDDY_SESS_ID="$(echo "$NEW_SESS" | jq -r '.session_id')"
    if [ -n "$BUDDY_CTL_CMD" ]; then
        "$BUDDY_CTL_CMD" init >/dev/null 2>&1 || true
    fi
    if [ -n "$APP_CLIENT_ID" ] && [ -n "$BUDDY_SESS_ID" ]; then
        "$REX_BIN" -C "$APP_CLIENT_ID" do session.select "session_id=$BUDDY_SESS_ID" >/dev/null 2>&1 || true
        echo "Created and switched Rex to Buddy session ($BUDDY_SESS_ID)."
    fi
fi
